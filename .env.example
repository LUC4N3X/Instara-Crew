DATABASE_URL="postgresql://instara:instara@127.0.0.1:5432/instara?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

SESSION_ENCRYPTION_KEY_BASE64=

# --- Meta Graph API & Instagram OAuth (Engine B - ufficiale) --------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Gemini on Vertex AI — no API key.
# Authenticate locally once with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# --- Browser runtime -------------------------------------------------
BROWSER_PROFILE_ROOT=./data/browser-profiles
BROWSER_HEADLESS=false
BROWSER_TIMEZONE=Europe/Rome
BROWSER_CHANNEL=

# --- Android app runtime (ADB + uiautomator2) ------------------------
# Percorso/comando adb. Lascia "adb" se Android Platform Tools e' nel PATH.
ADB_PATH=adb
# Interprete Python usato dal bridge. Vuoto = auto-detect (py/python/python3).
ANDROID_PYTHON=
# Ogni account Android salva adbSerial e package nel database dalla pagina /android.
# Dipendenze opzionali: pip install -r requirements-android.txt

# I nuovi job partono in dry-run: digita il commento ma non lo invia.
DRY_RUN=true

# --- Velocita' di pubblicazione -------------------------------------
# BURST: gli account assegnati possono partire insieme. I limiti per singolo
# account restano comunque applicati prima di ogni pubblicazione.
BURST_MODE=false
BURST_CONCURRENCY=

# --- Limiti per account ---------------------------------------------
RATE_LIMITS=on
# Quanti account pubblicano in parallelo (Browser e/o device Android).
POST_ACCOUNT_CONCURRENCY=2
ACCOUNT_MAX_PER_HOUR=4
ACCOUNT_MAX_PER_DAY=15
ACCOUNT_MIN_GAP_SEC=45
ACTIVE_HOUR_FROM=8
ACTIVE_HOUR_TO=23
