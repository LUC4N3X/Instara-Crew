DATABASE_URL="postgresql://instara:instara@127.0.0.1:5432/instara?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

SESSION_ENCRYPTION_KEY_BASE64=

# --- Meta Graph API & Instagram OAuth (Engine B - 100% a Norma) ------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Gemini on Vertex AI — no API key.
# Authenticate locally once with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

BROWSER_PROFILE_ROOT=./data/browser-profiles
# Lascia false: Instagram tratta il browser headless in modo piu' sospetto.
BROWSER_HEADLESS=false
BROWSER_TIMEZONE=Europe/Rome
# Usa il Chrome installato sul sistema invece del Chromium di Playwright: BROWSER_CHANNEL=chrome
BROWSER_CHANNEL=

# I nuovi job partono in dry-run: digita il commento ma non lo invia.
DRY_RUN=true

# --- Velocita' di pubblicazione -------------------------------------
# BURST: tutti gli account assegnati pubblicano insieme, senza pause.
# Attivabile anche per singolo run dalla checkbox in dashboard.
BURST_MODE=false
# Finestre browser simultanee in burst (default: numero di account del job).
BURST_CONCURRENCY=

# --- Limiti per account ---------------------------------------------
# RATE_LIMITS=off disattiva tutti i controlli qui sotto in un colpo solo.
# Ogni singolo valore a 0 disattiva solo quel controllo.
RATE_LIMITS=on
# Quanti account pubblicano in parallelo (finestre browser simultanee).
POST_ACCOUNT_CONCURRENCY=2
# Tetto massimo di commenti pubblicati da un singolo account.
ACCOUNT_MAX_PER_HOUR=4
ACCOUNT_MAX_PER_DAY=15
# Distanza minima tra due commenti dello stesso account.
ACCOUNT_MIN_GAP_SEC=45
# Finestra oraria in cui e' consentito pubblicare (ora locale).
ACTIVE_HOUR_FROM=8
ACTIVE_HOUR_TO=23
